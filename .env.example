# Contact form email delivery
# ---------------------------------------------------------------------------
# The contact form posts to /api/contact, which sends email via Resend
# (https://resend.com). Copy this file to `.env.local` and fill in the values.
#
# Until RESEND_API_KEY is set, the form still works: it falls back to opening
# the visitor's own email app addressed to CONTACT_TO_EMAIL.

# Your Resend API key (create one at https://resend.com/api-keys)
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=info@westccrealty.com

# The "from" address. Must be on a domain you've verified in Resend
# (verify westccrealty.com, then use something like the line below).
# CONTACT_FROM_EMAIL=90210 Estate <noreply@90210estate.com>

# GR CRM marketplace bridge
# Public site origin for agent login links (no trailing slash).
NEXT_PUBLIC_GRCRM_URL=https://grcrm.com

# Server-side read-only feed created by the CRM deployment.
CRM_PUBLIC_FEED_URL=https://grcrm.com/.netlify/functions/marketplace-public-feed

# Required tenant/site boundary. Never reuse another marketplace identifier here.
MARKETPLACE_ID=90210-estate
